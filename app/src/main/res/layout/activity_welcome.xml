<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ImageView
        android:id="@+id/imgHero"
        android:layout_width="420dp"
        android:layout_height="400dp"
        android:contentDescription="@string/desc_hero_welcome"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_hero_welcome"
        app:layout_constraintBottom_toTopOf="@id/tvAppName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:fontFamily="@font/quicksand_bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/imgHero"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textSize="13sp"
        android:fontFamily="@font/quicksand_regular"
        android:textColor="@color/secondary_text"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintBottom_toTopOf="@id/layoutChips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutChips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTagline"
        app:layout_constraintBottom_toTopOf="@id/btnGetStarted"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feature_plan"
            android:textSize="11sp"
            android:fontFamily="@font/quicksand_medium"
            android:clickable="false"
            app:chipBackgroundColor="@color/dark_primary_container"
            app:chipStrokeColor="@color/light_primary_container"
            app:chipStrokeWidth="1dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feature_music"
            android:textSize="11sp"
            android:fontFamily="@font/quicksand_medium"
            android:clickable="false"
            app:chipBackgroundColor="@color/dark_primary_container"
            app:chipStrokeColor="@color/light_primary_container"
            app:chipStrokeWidth="1dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feature_track"
            android:textSize="11sp"
            android:fontFamily="@font/quicksand_medium"
            android:clickable="false"
            app:chipBackgroundColor="@color/dark_primary_container"
            app:chipStrokeColor="@color/light_primary_container"
            app:chipStrokeWidth="1dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetStarted"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/btn_get_started"
        android:textSize="15sp"
        android:fontFamily="@font/quicksand_semibold"
        style="@style/Widget.ChillGuy.Button.Primary"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/btn_login"
        android:textSize="14sp"
        android:fontFamily="@font/quicksand_medium"
        style="@style/Widget.ChillGuy.Button.Secondary"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/tvNoEquipment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNoEquipment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_equipment"
        android:textSize="12sp"
        android:fontFamily="@font/quicksand_regular"
        android:textColor="@color/secondary_text"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>