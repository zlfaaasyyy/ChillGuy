<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWorkout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_pink"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="01"
            android:textSize="18sp"
            android:fontFamily="@font/quicksand_bold"
            android:textColor="@color/dark_on_secondary"
            android:gravity="center"
            android:background="@drawable/bg_day_circle"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProgramName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Body Warm Up"
                android:textSize="14sp"
                android:fontFamily="@font/quicksand_semibold"
                android:textColor="@color/dark_card" />

            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Body · 20 min"
                android:textSize="12sp"
                android:fontFamily="@font/quicksand_regular"
                android:textColor="@color/dark_background" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="invisible" />

    </LinearLayout>
</androidx.cardview.widget.CardView>